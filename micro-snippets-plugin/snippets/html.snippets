# Modern HTML and Django templates. Tabs represent nesting levels.
# Placeholders follow editing order from 1; no implicit final stop or bare $1 mirrors.

# Page setup
snippet html5
	<!doctype html>
	<html lang="${1:en}">
		<head>
			<meta charset="utf-8">
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>${2:Page title}</title>
			<meta name="description" content="${3:Page description}">
		</head>
		<body>
			${4}
		</body>
	</html>
snippet head
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>${1:Page title}</title>
		${2}
	</head>
snippet meta
	<meta name="${1:description}" content="${2}">
snippet link
	<link rel="stylesheet" href="${1:styles.css}">
snippet favicon
	<link rel="icon" href="${1:/favicon.svg}" type="${2:image/svg+xml}">
snippet script
	<script>
		${1}
	</script>
snippet script:defer
	<script src="${1:app.js}" defer></script>
snippet script:module
	<script type="module" src="${1:app.js}"></script>
snippet style
	<style>
		${1}
	</style>
snippet //
	<!-- ${1:Comment} -->

# Structure: prefer semantic elements where they describe the content.
snippet main
	<main>
		${1}
	</main>
snippet header
	<header>
		${1}
	</header>
snippet footer
	<footer>
		${1}
	</footer>
snippet nav
	<nav aria-label="${1:Main}">
		${2}
	</nav>
snippet section
	<section>
		<h2>${1:Heading}</h2>
		${2}
	</section>
snippet article
	<article>
		<h2>${1:Title}</h2>
		${2}
	</article>
snippet aside
	<aside>
		${1}
	</aside>
snippet div
	<div class="${1:container}">
		${2}
	</div>
snippet span
	<span class="${1}">${2}</span>
snippet h1
	<h1>${1:Heading}</h1>
snippet h2
	<h2>${1:Heading}</h2>
snippet h3
	<h3>${1:Heading}</h3>
snippet p
	<p>${1}</p>
snippet strong
	<strong>${1}</strong>
snippet em
	<em>${1}</em>
snippet code
	<code>${1}</code>
snippet pre
	<pre><code>${1}</code></pre>
snippet a
	<a href="${1:/}">${2:Link text}</a>
snippet a:blank
	<a href="${1:https://example.com}" target="_blank" rel="noopener noreferrer">${2:Link text}</a>
snippet ul
	<ul>
		<li>${1}</li>
	</ul>
snippet ol
	<ol>
		<li>${1}</li>
	</ol>
snippet li
	<li>${1}</li>
snippet dl
	<dl>
		<dt>${1:Term}</dt>
		<dd>${2:Description}</dd>
	</dl>
snippet time
	<time datetime="${1:2026-01-01}">${2:January 1, 2026}</time>

# Media: use descriptive alt text, or empty alt for decorative images.
snippet img
	<img src="${1:image.webp}" alt="${2}" width="${3:800}" height="${4:600}">
# Lazy loading is for images below the fold, not the primary hero image.
snippet img:lazy
	<img src="${1:image.webp}" alt="${2}" width="${3:800}" height="${4:600}" loading="lazy" decoding="async">
snippet figure
	<figure>
		<img src="${1:image.webp}" alt="${2}" width="${3:800}" height="${4:600}">
		<figcaption>${5:Caption}</figcaption>
	</figure>
snippet video
	<video controls preload="metadata" src="${1:video.mp4}">
		<track kind="captions" src="${2:captions.vtt}" srclang="${3:en}" label="${4:English}" default>
	</video>
snippet iframe
	<iframe src="${1:https://example.com}" title="${2:Embedded content}" loading="lazy"></iframe>

# Forms: wrapping labels avoid needing duplicated id/for placeholders.
# Plain form uses GET; use djform below for Django POST with CSRF.
snippet form
	<form action="${1:/search/}" method="get">
		${2}
		<button type="submit">${3:Search}</button>
	</form>
snippet fieldset
	<fieldset>
		<legend>${1:Group label}</legend>
		${2}
	</fieldset>
snippet input
	<label>
		${1:Label}
		<input type="text" name="${2:name}">
	</label>
snippet input:email
	<label>
		${1:Email}
		<input type="email" name="${2:email}" autocomplete="email" required>
	</label>
snippet input:password
	<label>
		${1:Password}
		<input type="password" name="${2:password}" autocomplete="${3:current-password}" required>
	</label>
snippet input:number
	<label>
		${1:Quantity}
		<input type="number" name="${2:quantity}" min="${3:1}" step="${4:1}">
	</label>
snippet input:checkbox
	<label>
		<input type="checkbox" name="${1:enabled}" value="${2:yes}">
		${3:Enable this option}
	</label>
snippet input:radio
	<label>
		<input type="radio" name="${1:choice}" value="${2:value}">
		${3:Option label}
	</label>
snippet input:file
	<label>
		${1:Upload file}
		<input type="file" name="${2:file}" accept="${3:image/*}">
	</label>
snippet input:hidden
	<input type="hidden" name="${1:name}" value="${2:value}">
snippet textarea
	<label>
		${1:Message}
		<textarea name="${2:message}" rows="${3:5}">${4}</textarea>
	</label>
snippet select
	<label>
		${1:Choose an option}
		<select name="${2:choice}">
			<option value="">Choose…</option>
			<option value="${3:value}">${4:Option label}</option>
		</select>
	</label>
snippet opt
	<option value="${1:value}">${2:Option label}</option>
snippet button
	<button type="button">${1:Button text}</button>
snippet button:s
	<button type="submit">${1:Save}</button>

# Native disclosure/dialog elements
snippet details
	<details>
		<summary>${1:Show more}</summary>
		${2}
	</details>
# Open using showModal() in JavaScript; method=dialog closes without a request.
snippet dialog
	<dialog>
		<form method="dialog">
			<p>${1:Dialog message}</p>
			<button type="submit">${2:Close}</button>
		</form>
	</dialog>

# Tables
snippet table
	<table>
		<caption>${1:Table description}</caption>
		<thead>
			<tr>
				<th scope="col">${2:Column heading}</th>
			</tr>
		</thead>
		<tbody>
			<tr>
				<td>${3:Value}</td>
			</tr>
		</tbody>
	</table>
snippet tr
	<tr>
		${1}
	</tr>
snippet th
	<th scope="${1:col}">${2:Heading}</th>
snippet td
	<td>${1}</td>

# Attributes: insert inside an existing opening tag.
snippet cls
	class="${1}"
snippet id
	id="${1}"
snippet data
	data-${1:name}="${2:value}"
snippet aria
	aria-label="${1:Accessible name}"

# Django templates
snippet djt
	{% ${1} %}
snippet djv
	{{ ${1:value} }}
snippet djextends
	{% extends "${1:base.html}" %}
snippet djload
	{% load ${1:static} %}
# Requires {% load static %} in this template.
snippet djstatic
	{% static '${1:css/app.css}' %}
snippet djurl
	{% url '${1:product-list}'${2} %}
# URL arguments slot includes a leading space, e.g. " product.pk".
snippet djblock
	{% block ${1:content} %}
		${2}
	{% endblock %}
snippet djinclude
	{% include "${1:partials/card.html}"${2} %}
snippet djif
	{% if ${1:condition} %}
		${2}
	{% endif %}
snippet djifelse
	{% if ${1:condition} %}
		${2}
	{% else %}
		${3}
	{% endif %}
snippet djfor
	{% for ${1:item} in ${2:items} %}
		${3}
	{% endfor %}
snippet djforempty
	{% for ${1:item} in ${2:items} %}
		${3}
	{% empty %}
		<p>${4:Nothing here yet.}</p>
	{% endfor %}
snippet djwith
	{% with ${1:total}=${2:items.count} %}
		${3}
	{% endwith %}
snippet djcsrf
	{% csrf_token %}
# Django 4.1+: as_div includes labels, help text, and errors.
# Add enctype="multipart/form-data" for uploads.
snippet djform
	<form method="post" action="${1}">
		{% csrf_token %}
		{{ ${2:form}.as_div }}
		<button type="submit">${3:Save}</button>
	</form>
snippet djcomment
	{% comment %}
		${1}
	{% endcomment %}
# Serialize data safely; read textContent and JSON.parse it in JavaScript.
snippet djjson
	{{ ${1:data}|json_script:"${2:page-data}" }}
